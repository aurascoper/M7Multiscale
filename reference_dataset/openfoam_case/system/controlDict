FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
application     porousSimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1200;
deltaT          0.05;
writeControl    timeStep;
writeInterval   6000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
